# Build
/target/
**/*.rs.bk

# OS / editor
.DS_Store
**/.DS_Store
*.swp
*~
.idea/
.vscode/
*.code-workspace

# Local env / secrets (never commit)
.env
.env.*
!.env.example

# Tooling / session noise
sessions/
.grok/
*.log

# Occasional local scratch (keep probes under tests/clang-probe/)
/tmp/
.tmp-bottle/
.kh/

# Linux guest/host crash dumps (kh disables RLIMIT_CORE; still never commit)
/core
core
core.[0-9]*
*.core

# Local guest/docker scratch dirs (bench + 7zz outputs live here — never commit)
#   .tmp/kh-bench-fair/   ← scripts/bench-fair-local.sh  (summary + artifacts/*.7z)
#   .tmp/kh-out/          ← scripts/docker-kh.sh 7zz durable output
.tmp/
.tmp-*/
/tmp/kh-bench/
